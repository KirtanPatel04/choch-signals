    },
    {
      "name": "Backtest: my_strategy (your own)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--strategy", "my_strategy"],
      "console": "integratedTerminal"
